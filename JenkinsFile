
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                bat 'mvn -B clean package'
            }
        }
    }

  
post {
    success {
        echo 'Build successful. Sending email...'
        try {
            emailext(
                to: 'sampath2k6@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Build completed successfully.\nJob: ${env.JOB_NAME}\nBuild: ${env.BUILD_NUMBER}\nConsole: ${env.BUILD_URL}console"
            )
            echo 'Email step completed without an exception.'
        } catch (err) {
            echo "Email sending error: ${err}"
        }
    }
    failure {
        echo 'Pipeline failed. Check the console output.'
    }
}

